# Normalize all text files to LF in the repository
* text=auto eol=lf

# Explicitly LF for source files
*.java   text eol=lf
*.xml    text eol=lf
*.sql    text eol=lf
*.md     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.json   text eol=lf
*.properties text eol=lf

# Binary files — no conversion
*.jar    binary
*.class  binary
*.png    binary
*.jpg    binary
