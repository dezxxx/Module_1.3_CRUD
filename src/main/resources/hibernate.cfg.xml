<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">

<hibernate-configuration>
    <session-factory>

        <!-- Connection -->
        <property name="hibernate.connection.driver_class">com.mysql.cj.jdbc.Driver</property>
        <property name="hibernate.connection.url">jdbc:mysql://localhost:3306/hibernate_db_1</property>
        <property name="hibernate.connection.username">root</property>
        <property name="hibernate.connection.password">dezxxx</property>

        <!-- Dialect -->
        <property name="hibernate.dialect">org.hibernate.dialect.MySQLDialect</property>

        <!-- Schema validation — Flyway manages the schema -->
        <property name="hibernate.hbm2ddl.auto">validate</property>

        <!-- Entity classes -->
        <mapping class="com.dezxxx.hometasks.crud.model.Writer"/>
        <mapping class="com.dezxxx.hometasks.crud.model.Post"/>
        <mapping class="com.dezxxx.hometasks.crud.model.Label"/>

    </session-factory>
</hibernate-configuration>